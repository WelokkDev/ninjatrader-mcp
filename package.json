{
  "name": "ninjatrader-mcp",
  "version": "0.1.0",
  "description": "MCP server bridging Claude Code to NinjaTrader for futures zone detection and trade journaling",
  "type": "module",
  "bin": {
    "ninjatrader-mcp": "./build/index.js"
  },
  "scripts": {
    "generate:schema": "ts-json-schema-generator --path src/private/sma/types.ts --type SMAConfig --tsconfig tsconfig.json --out src/private/sma/config/schema/sma-config.schema.json",
    "generate:csharp": "shx mkdir -p src/private/ninjatrader/indicators/generated && quicktype --src src/private/sma/config/schema/sma-config.schema.json --src-lang schema --out src/private/ninjatrader/indicators/generated/SMAConfig.generated.cs --lang csharp --top-level SMAConfig --namespace NinjaTrader.NinjaScript.Indicators.Generated --framework NewtonSoft --array-type list --features attributes-only --csharp-version 6 --number-type double",
    "build": "npm run generate:schema && npm run generate:csharp && tsc && shx chmod +x build/index.js && node src/private/scripts/copy-assets.mjs",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "inspect": "npx @modelcontextprotocol/inspector build/index.js",
    "seed": "node build/scripts/seed.js",
    "start": "node build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:zones": "tsc && node build/private/tests/test-zones.js",
    "rebuild-bars": "tsc && node build/scripts/rebuild-bars.js",
    "dump-bars": "tsc && node build/scripts/dump-bars.js",
    "audit-bars": "tsc && node build/scripts/audit-bars.js",
    "backtest:observe": "tsc && node src/private/scripts/copy-assets.mjs && node build/private/scripts/run-backtest-observable.js"
  },
  "files": [
    "build"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WelokkDev/ninjatrader-mcp.git"
  },
  "keywords": [
    "mcp",
    "ninjatrader",
    "futures",
    "trading"
  ],
  "author": "",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/WelokkDev/ninjatrader-mcp/issues"
  },
  "homepage": "https://github.com/WelokkDev/ninjatrader-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^12.8.0",
    "ws": "^8.20.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.5.2",
    "quicktype": "^23.2.6",
    "shx": "^0.4.0",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.5"
  }
}
